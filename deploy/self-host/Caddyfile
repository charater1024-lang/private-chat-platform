{
    admin off
    email {$CADDY_ACME_EMAIL}
    servers {
        protocols h1 h2
        max_header_size 32KiB
        timeouts {
            read_header 10s
            read_body_idle 30s
            write_idle 2m
            idle 2m
        }
    }
}

{$MATRIX_PUBLIC_HOST} {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin "*"
        header Content-Type "application/json"
        respond "{\"m.homeserver\":{\"base_url\":\"https://{$MATRIX_PUBLIC_HOST}\"}}" 200
    }

    # This stack is a Matrix reference, not the custom /v1 application
    # homeserver. Fail explicitly instead of ever forwarding /v1 to Synapse.
    @unsupported_custom_api path /v1/*
    handle @unsupported_custom_api {
        respond 503
    }

    # Only the authenticated Matrix client namespace is public. Legacy
    # unauthenticated media and broad Synapse helper namespaces remain closed.
    @matrix_client path /_matrix/client/*
    request_body @matrix_client {
        max_size 256MB
    }
    handle @matrix_client {
        reverse_proxy synapse:8008 {
            health_uri /_matrix/client/versions
            health_interval 30s
        }
    }

    handle {
        respond 404
    }
}
