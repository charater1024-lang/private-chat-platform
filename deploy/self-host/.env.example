# Copy this file to .env and replace every REPLACE_* value before bootstrap.
# These values are not secrets. Never put passwords, access tokens, or private
# keys in .env; bootstrap stores generated material under the ignored runtime/.

COMPOSE_PROJECT_NAME=privacy-talk
MATRIX_SERVER_NAME=REPLACE_WITH_CHAT_DOMAIN
MATRIX_PUBLIC_HOST=REPLACE_WITH_CHAT_DOMAIN
CADDY_ACME_EMAIL=REPLACE_WITH_OPERATOR_EMAIL

# Pin both a release tag and a registry digest after reviewing upstream release
# notes. The placeholders deliberately prevent an accidental production pull.
SYNAPSE_IMAGE=ghcr.io/element-hq/synapse:v1.157.1@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_IMAGE=docker.io/library/postgres:REPLACE_WITH_REVIEWED_VERSION-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST
CADDY_IMAGE=docker.io/library/caddy:REPLACE_WITH_REVIEWED_VERSION-alpine@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Synapse's maintained container defaults to UID/GID 991. Change these only
# after preparing persistent volume ownership and testing restore/rollback.
SYNAPSE_UID=991
SYNAPSE_GID=991
