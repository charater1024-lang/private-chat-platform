version: 1
disable_existing_loggers: false

formatters:
  privacy:
    format: '%(asctime)s %(levelname)s %(name)s %(message)s'

handlers:
  console:
    class: logging.StreamHandler
    formatter: privacy
    level: WARNING
    stream: ext://sys.stderr

# Successful access requests contain IP addresses, paths and room/event
# identifiers. Keep them out of stdout; warnings/errors remain available for
# incident response and are bounded by the Docker logging policy.
loggers:
  synapse.access.http:
    level: WARNING
    handlers:
      - console
    propagate: false
  synapse.http.client:
    level: WARNING
    handlers:
      - console
    propagate: false

root:
  level: WARNING
  handlers:
    - console
